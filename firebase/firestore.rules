rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSupportAdmin() {
      return signedIn()
        && request.auth.token.email == 'saschad1711@gmail.com';
    }

    function isSupportOwner(userId) {
      return signedIn()
        && request.auth.uid == userId;
    }

    function householdMember(householdId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid)
        );
    }

    function householdOwner(householdId) {
      return signedIn()
        && get(
          /databases/$(database)/documents/households/$(householdId)
        ).data.ownerUid == request.auth.uid;
    }

    function householdOwnerAfter(householdId) {
      return signedIn()
        && getAfter(
          /databases/$(database)/documents/households/$(householdId)
        ).data.ownerUid == request.auth.uid;
    }

    function validInvitedMember(householdId, userId) {
      let invitation = get(
        /databases/$(database)/documents/householdInvites/$(request.resource.data.inviteId)
      );

      return signedIn()
        && userId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'member'
        && invitation.data.status == 'pending'
        && invitation.data.householdId == householdId
        && invitation.data.email == request.auth.token.email;
    }

    match /users/{userId}/{document=**} {
      allow read, write:
        if signedIn()
        && request.auth.uid == userId;
    }

    match /households/{householdId} {
      allow read:
        if householdMember(householdId);

      allow create:
        if signedIn()
        && request.resource.data.id == householdId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == request.auth.token.email;

      allow update, delete:
        if householdOwner(householdId);

      match /members/{userId} {
        allow read:
          if householdMember(householdId);

        allow create:
          if (
            householdOwnerAfter(householdId)
            && userId == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.role == 'owner'
          )
          || validInvitedMember(householdId, userId);

        allow update:
          if householdOwner(householdId);

        allow delete:
          if householdOwner(householdId)
          || (
            signedIn()
            && userId == request.auth.uid
            && resource.data.role == 'member'
          );
      }

      match /terraControl/{documentId} {
        allow read:
          if householdMember(householdId);

        allow create, update:
          if householdMember(householdId)
          || householdOwnerAfter(householdId);

        allow delete:
          if householdOwner(householdId);
      }
    }

    match /householdInvites/{inviteId} {
      allow get, list:
        if signedIn()
        && (
          resource.data.email == request.auth.token.email
          || householdOwner(resource.data.householdId)
        );

      allow create:
        if signedIn()
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.status == 'pending'
        && request.resource.data.invitedByUid == request.auth.uid
        && request.resource.data.invitedByEmail == request.auth.token.email
        && householdOwner(request.resource.data.householdId);

      allow update:
        if signedIn()
        && resource.data.status == 'pending'
        && resource.data.email == request.auth.token.email
        && request.resource.data.email == resource.data.email
        && request.resource.data.householdId == resource.data.householdId
        && request.resource.data.invitedByUid == resource.data.invitedByUid
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedUid == request.auth.uid;

      allow delete:
        if householdOwner(resource.data.householdId);
    }

    match /taxonomy/{taxonId} {
      allow get, list:
        if signedIn();

      allow create, update:
        if signedIn();

      allow delete:
        if false;
    }

    match /appAnnouncements/{announcementId} {
      allow read:
        if signedIn();

      allow create, update:
        if isSupportAdmin()
        && announcementId == 'current'
        && request.resource.data.keys().hasOnly([
          'title',
          'message',
          'important',
          'active',
          'publishedAt',
          'publishedAtMs'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.important is bool
        && request.resource.data.active is bool
        && request.resource.data.publishedAtMs is int;

      allow delete:
        if false;
    }

    match /supportThreads/{userId} {
      allow read:
        if isSupportOwner(userId)
        || isSupportAdmin();

      allow create:
        if isSupportOwner(userId)
        && request.resource.data.ownerUid == userId
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.status == 'open'
        && request.resource.data.lastSenderRole == 'user'
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 160;

      allow update:
        if isSupportAdmin()
        || (
          isSupportOwner(userId)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.ownerEmail == resource.data.ownerEmail
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdAtMs == resource.data.createdAtMs
          && request.resource.data.status == 'open'
          && request.resource.data.lastSenderRole == 'user'
          && request.resource.data.lastMessage is string
          && request.resource.data.lastMessage.size() <= 160
        );

      allow delete:
        if false;

      match /messages/{messageId} {
        allow read:
          if isSupportOwner(userId)
          || isSupportAdmin();

        allow create:
          if signedIn()
          && request.resource.data.threadId == userId
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderEmail == request.auth.token.email
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && (
            (
              isSupportOwner(userId)
              && request.resource.data.senderRole == 'user'
            )
            ||
            (
              isSupportAdmin()
              && request.resource.data.senderRole == 'admin'
            )
          );

        allow update, delete:
          if false;
      }
    }
  }
}
