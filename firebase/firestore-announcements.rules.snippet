function validAnnouncementTranslation(value) {
  return value is map
    && value.keys().hasAll(['title', 'message'])
    && value.keys().hasOnly(['title', 'message'])
    && value.title is string
    && value.title.size() > 0
    && value.title.size() <= 120
    && value.message is string
    && value.message.size() > 0
    && value.message.size() <= 1600;
}

function validAnnouncementTranslations(data) {
  return !data.keys().hasAny(['translations'])
    || (
      data.translations is map
      && data.translations.keys().hasAll(['de', 'en', 'it', 'hu'])
      && data.translations.keys().hasOnly(['de', 'en', 'it', 'hu'])
      && validAnnouncementTranslation(data.translations.de)
      && validAnnouncementTranslation(data.translations.en)
      && validAnnouncementTranslation(data.translations.it)
      && validAnnouncementTranslation(data.translations.hu)
    );
}

match /appAnnouncements/{announcementId} {
  allow read:
    if signedIn();

  allow create, update:
    if isSupportAdmin()
    && announcementId == 'current'
    && request.resource.data.keys().hasOnly([
      'title',
      'message',
      'important',
      'active',
      'publishedAt',
      'publishedAtMs',
      'translations'
    ])
    && request.resource.data.title is string
    && request.resource.data.title.size() > 0
    && request.resource.data.title.size() <= 80
    && request.resource.data.message is string
    && request.resource.data.message.size() > 0
    && request.resource.data.message.size() <= 1000
    && request.resource.data.important is bool
    && request.resource.data.active is bool
    && request.resource.data.publishedAtMs is int
    && validAnnouncementTranslations(request.resource.data);

  allow delete:
    if false;
}
