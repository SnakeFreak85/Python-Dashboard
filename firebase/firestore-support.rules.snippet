/*
 * TerraControl Supportchat
 *
 * Diesen Block innerhalb von
 * match /databases/{database}/documents { ... }
 * in die vorhandenen Firestore-Regeln einfügen.
 *
 * Vorhandene Regeln für users, terraControl und taxonomy
 * dürfen dabei nicht ersetzt werden.
 */

function supportSignedIn() {
  return request.auth != null;
}

function supportAdmin() {
  return supportSignedIn()
    && request.auth.token.email == "saschad1711@gmail.com";
}

function supportOwner(userId) {
  return supportSignedIn()
    && request.auth.uid == userId;
}

function validSupportThreadCreate(userId) {
  return supportOwner(userId)
    && request.resource.data.keys().hasOnly([
      "ownerUid",
      "ownerEmail",
      "ownerName",
      "status",
      "createdAt",
      "createdAtMs",
      "updatedAt",
      "updatedAtMs",
      "lastMessage",
      "lastSenderRole",
      "lastSenderName"
    ])
    && request.resource.data.keys().hasAll([
      "ownerUid",
      "ownerEmail",
      "ownerName",
      "status",
      "createdAt",
      "createdAtMs",
      "updatedAt",
      "updatedAtMs",
      "lastMessage",
      "lastSenderRole",
      "lastSenderName"
    ])
    && request.resource.data.ownerUid == userId
    && request.resource.data.ownerEmail == request.auth.token.email
    && request.resource.data.ownerName is string
    && request.resource.data.ownerName.size() <= 120
    && request.resource.data.status == "open"
    && request.resource.data.lastMessage is string
    && request.resource.data.lastMessage.size() <= 160
    && request.resource.data.lastSenderRole == "user"
    && request.resource.data.lastSenderName is string
    && request.resource.data.lastSenderName.size() <= 120;
}

function validSupportThreadOwnerUpdate(userId) {
  return supportOwner(userId)
    && request.resource.data.ownerUid == resource.data.ownerUid
    && request.resource.data.ownerEmail == resource.data.ownerEmail
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.createdAtMs == resource.data.createdAtMs
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "ownerName",
      "status",
      "updatedAt",
      "updatedAtMs",
      "lastMessage",
      "lastSenderRole",
      "lastSenderName"
    ])
    && request.resource.data.status == "open"
    && request.resource.data.lastMessage is string
    && request.resource.data.lastMessage.size() <= 160
    && request.resource.data.lastSenderRole == "user"
    && request.resource.data.lastSenderName is string
    && request.resource.data.lastSenderName.size() <= 120;
}

function validSupportThreadAdminUpdate() {
  return supportAdmin()
    && request.resource.data.ownerUid == resource.data.ownerUid
    && request.resource.data.ownerEmail == resource.data.ownerEmail
    && request.resource.data.ownerName == resource.data.ownerName
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.createdAtMs == resource.data.createdAtMs
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "status",
      "updatedAt",
      "updatedAtMs",
      "lastMessage",
      "lastSenderRole",
      "lastSenderName"
    ])
    && request.resource.data.status == "open"
    && request.resource.data.lastMessage is string
    && request.resource.data.lastMessage.size() <= 160
    && request.resource.data.lastSenderRole == "admin"
    && request.resource.data.lastSenderName == "TerraControl Support";
}

function validSupportMessage(userId) {
  return supportSignedIn()
    && request.resource.data.keys().hasOnly([
      "threadId",
      "senderUid",
      "senderEmail",
      "senderName",
      "senderRole",
      "text",
      "createdAt",
      "clientCreatedAt"
    ])
    && request.resource.data.keys().hasAll([
      "threadId",
      "senderUid",
      "senderEmail",
      "senderName",
      "senderRole",
      "text",
      "createdAt",
      "clientCreatedAt"
    ])
    && request.resource.data.threadId == userId
    && request.resource.data.senderUid == request.auth.uid
    && request.resource.data.senderEmail == request.auth.token.email
    && request.resource.data.senderName is string
    && request.resource.data.senderName.size() <= 120
    && request.resource.data.text is string
    && request.resource.data.text.size() > 0
    && request.resource.data.text.size() <= 2000
    && (
      (
        supportOwner(userId)
        && request.resource.data.senderRole == "user"
      )
      ||
      (
        supportAdmin()
        && request.resource.data.senderRole == "admin"
        && request.resource.data.senderName == "TerraControl Support"
      )
    );
}

match /supportThreads/{userId} {
  allow read: if supportOwner(userId) || supportAdmin();
  allow create: if validSupportThreadCreate(userId);
  allow update: if validSupportThreadOwnerUpdate(userId)
    || validSupportThreadAdminUpdate();
  allow delete: if false;

  match /messages/{messageId} {
    allow read: if supportOwner(userId) || supportAdmin();
    allow create: if validSupportMessage(userId);
    allow update, delete: if false;
  }
}
